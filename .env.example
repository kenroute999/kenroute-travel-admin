# KenRoute Travel Admin — environment configuration.
# Copy values into `.env.local` (git-ignored) for local development.
#
# Base URL of the KenRoute backend API (no trailing slash).
# Required backend contract for login:
#   POST {VITE_API_URL}/auth/login    { "email", "password" }
#     -> { "accessToken", "refreshToken", "user"? }   (401 = invalid credentials)
#   GET  {VITE_API_URL}/me            (Authorization: Bearer <accessToken>)
#     -> authenticated user { id, email, name?, operatorId?, role }
#   POST {VITE_API_URL}/auth/refresh   { "refreshToken" }
#     -> rotated { "accessToken", "refreshToken" }
# The access token carries claims: userId, operatorId, role (~15 min lifetime).
VITE_API_URL=http://127.0.0.1:4000
